---
import "../styles/global.css";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle =
  title ?? `${site.title} — ${site.eventName} | ${site.dateLabel}`;
const pageDescription =
  description ??
  `${site.eventName}「${site.title}」。${site.dateLabel}、${site.venue}。`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="トップへ戻る">
        <span class="re">re</span>collage
      </a>
      <nav class="site-nav" aria-label="セクション">
        <a href="#formation">FORMATION</a>
        <a href="#sequence">SEQUENCE</a>
        <a href="#venue">VENUE</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <p class="foot-title">
        <span class="re">re</span>collage
      </p>
      <p>
        {site.eventName} — {site.dateLabel} / {site.venue}
      </p>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 0 16px;
        background: rgba(236, 236, 229, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }

      .wordmark {
        font-family: var(--font-display);
        font-size: 22px;
        letter-spacing: 0.03em;
        text-decoration: none;
        padding: 10px 4px;
        line-height: 1;
      }

      .wordmark .re,
      .foot-title .re {
        color: var(--accent);
      }

      .site-nav {
        display: flex;
        gap: 2px;
      }

      .site-nav a {
        font-family: var(--font-label);
        font-size: 15px;
        letter-spacing: 0.14em;
        text-decoration: none;
        padding: 14px 10px;
        min-height: 48px;
        display: inline-flex;
        align-items: center;
      }

      .site-nav a:hover,
      .site-nav a:focus-visible {
        color: var(--accent);
      }

      .site-footer {
        border-top: 1px solid var(--line);
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 40px 20px 56px;
        color: var(--ink-dim);
        font-size: 14px;
      }

      .foot-title {
        font-family: var(--font-display);
        font-size: 28px;
        color: var(--ink);
        margin: 0 0 8px;
      }

      .site-footer p {
        margin: 4px 0;
      }
    </style>
    <script is:inline>
      (function () {
        var params = new URLSearchParams(location.search);
        var h = new Date().getHours();
        var phase =
          params.get("phase") ||
          (h >= 6 && h < 10
            ? "morning"
            : h >= 10 && h < 16
              ? "day"
              : h >= 16 && h < 19
                ? "evening"
                : "night");
        document.documentElement.dataset.phase = phase;
        var cv = document.getElementById("dot-clock");
        if (cv) {
          var ctx = cv.getContext("2d");
          var off = document.createElement("canvas");
          var draw = function () {
            var d = new Date();
            var t = [d.getHours(), d.getMinutes(), d.getSeconds()]
              .map(function (n) {
                return String(n).padStart(2, "0");
              })
              .join(":");
            off.width = 470;
            off.height = 96;
            var o = off.getContext("2d");
            o.font = '84px "Bebas Neue", sans-serif';
            o.fillStyle = "#fff";
            o.textBaseline = "middle";
            o.fillText(t, 4, 54);
            var img = o.getImageData(0, 0, off.width, off.height).data;
            ctx.clearRect(0, 0, cv.width, cv.height);
            ctx.fillStyle = "#f4d21f";
            for (var y = 0; y < off.height; y += 6) {
              for (var x = 0; x < off.width; x += 6) {
                if (img[(y * off.width + x) * 4 + 3] > 100) {
                  ctx.beginPath();
                  ctx.arc(x + 1, y + 1, 2.1, 0, Math.PI * 2);
                  ctx.fill();
                }
              }
            }
          };
          draw();
          if (document.fonts && document.fonts.ready)
            document.fonts.ready.then(draw);
          setInterval(draw, 1000);
        }
        var slip = document.getElementById("egg-slip");
        if (slip) {
          var n = 0;
          slip.addEventListener("click", function () {
            n++;
            slip.classList.remove("shake");
            void slip.offsetWidth;
            slip.classList.add("shake");
            if (n >= 5) {
              slip.classList.add("fallen");
              document.getElementById("egg-msg").classList.add("shown");
            }
          });
        }
      })();
    </script>
  </body>
</html>
